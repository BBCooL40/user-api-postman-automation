      "name": "01 - Create User",
      "item": [
        {
          "name": "Happy Path",
          "item": [
            {
              "name": "Create user - valid data",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 201\", () => {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst responseJson = pm.response.json();\r\n\r\npm.collectionVariables.set(\r\n    \"createdUserId\",\r\n    responseJson.id\r\n);\r\n\r\npm.test(\"Response contains a generated id\", () => {\r\n    pm.expect(responseJson.id).to.be.a(\"string\").and.not.empty;\r\n});\r\n\r\npm.test(\"Returned name is correct\", () => {\r\n    pm.expect(responseJson.name)\r\n        .to.eql(pm.variables.get(\"userName\"));\r\n});\r\n\r\npm.test(\"Returned email is correct\", () => {\r\n    pm.expect(responseJson.email)\r\n        .to.eql(pm.variables.get(\"userEmail\"));\r\n});\r\n\r\npm.test(\"Returned age is correct\", () => {\r\n    pm.expect(responseJson.age)\r\n        .to.eql(Number(pm.variables.get(\"userAge\")));\r\n});"
                    ]
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.variables.set(\"userName\", \"Anton\");\r\npm.variables.set(\"userAge\", 37);\r\n\r\nconst uniqueEmail = `anton.${Date.now()}@example.com`;\r\npm.variables.set(\"userEmail\", uniqueEmail);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"name\": \"{{userName}}\",\r\n  \"email\": \"{{userEmail}}\",\r\n  \"age\": {{userAge}}\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/users",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "users"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Get created user by id",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status code is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst responseJson = pm.response.json();\r\npm.test(\"Returned user has the expected id\", () => {\r\n    pm.expect(responseJson.id)\r\n        .to.eql(\r\n            pm.collectionVariables.get(\"createdUserId\")\r\n        );\r\n});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/users/{{createdUserId}}",
                  "host": [
                    "{{baseUrl}}"
